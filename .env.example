# Copy to .env and fill in real values. Never commit .env.

# Supabase Postgres — Project Settings -> Database -> Connection string.
# Pooled (6543, pgbouncer) for the app runtime; direct (5432) for `npm run db:migrate`.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Supabase project URL and service_role key — Project Settings -> API.
# Server-side only (F5 Storage: bucket access, signed URLs). Never expose to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to HMAC-sign session cookies (lib/auth/session.ts).
# Generate with: openssl rand -base64 32
AUTH_SECRET=
DEEPSEEK_API_KEY=your_deepseek_api_key